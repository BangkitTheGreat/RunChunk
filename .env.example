# Copy to .env.local and replace with credentials from Supabase and Inngest dashboards.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY
# Your app's public origin, used for same-origin mutation checks behind proxies.
APP_URL=http://localhost:3000
# Local only: use Inngest Dev Server. Remove in production.
INNGEST_DEV=1
# Required for Inngest Cloud dispatch and signed function invocation in production.
INNGEST_EVENT_KEY=YOUR_INNGEST_EVENT_KEY
INNGEST_SIGNING_KEY=YOUR_INNGEST_SIGNING_KEY
# Credentials Vault (server only). 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation: add CREDENTIALS_KEY_V2 and set CREDENTIALS_KEY_VERSION=2; keep V1 until old rows are re-encrypted.
CREDENTIALS_KEY_V1=YOUR_BASE64_32_BYTE_KEY
CREDENTIALS_KEY_VERSION=1
